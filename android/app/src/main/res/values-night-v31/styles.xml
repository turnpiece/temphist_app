<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode counterpart of values-v31/styles.xml: night outranks API level in
         resource matching, so without this values-night would win on Android 12+. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#242456</item>
    </style>
</resources>
